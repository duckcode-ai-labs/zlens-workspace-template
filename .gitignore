# ZLens: generated, cached and personal files. Never commit these.
dql-manifest.json
*.run.json
**/.dql/runs/
**/.dql/cache/
**/.dql/imports/
**/.dql/local/
**/.dql/runtimes/
**/.dql/connectors/
**/.dql/preview-data/
**/.dql/memory/
**/.dql/migration-staging/
**/.dql/docker-starter/
**/.dql/oauth-credentials.json
**/.dql/provider-settings.json
**/.dql/mcp-servers.json
**/.dql-user-prefs.json

# Local AI agent client config generated by `zlens connect`
.mcp.json
.codex/
.cursor/

# Warehouses. The committed sample is the one exception: a worker clones this
# repository and has no seed step, so the first-hour DuckDB file travels with it.
*.duckdb
!sample/starter.duckdb
*.duckdb.wal
sample/seed.json

# Secrets never go in git: the connection reads them from environment variables.
.env
.env.*

# Build output and dependencies
build/
node_modules/
package-lock.json

# OS
.DS_Store
